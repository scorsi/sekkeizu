#!/usr/bin/env bash
# Refuses a commit that would store an encrypted tree (.gitattributes: secrets/, modules-private/) in clear.
# git skips an unconfigured filter without a word: in a clone that was never `git-crypt unlock`ed,
# a new file there would be committed as is. Checks the index, which holds what git stores, so CI
# runs it too, before or after unlocking. Enabled per clone: `git config core.hooksPath scripts/hooks`.
set -euo pipefail

bad=0
while IFS= read -r -d '' f; do
  # git-crypt blobs start with "\0GITCRYPT\0".
  if [ "$(git cat-file blob ":$f" | head -c 10 | tr -d '\0')" != GITCRYPT ]; then
    echo "en clair dans l'index : $f (git-crypt unlock, puis git rm --cached \"$f\" && git add \"$f\")" >&2
    bad=1
  fi
done < <(git ls-files -z -- secrets modules-private)
exit "$bad"
